@@ -0,0 +1,99 @@
+name: Personal signed APK
+
+# Builds the github flavor as a release APK signed with your own key, so every build installs over
+# the previous one and keeps the app's settings. The key never lives in the repository: it comes
+# from two repository secrets (Settings -> Secrets and variables -> Actions):
+#   HEADUNIT_KEYSTORE_BASE64   the .jks file, base64-encoded
+#   HEADUNIT_KEYSTORE_PASSWORD its password (store and key share it)
+# Each run attaches the APK to a pre-release named personal-<run number>, easy to open on a phone.
+
+on:
+  push:
+    branches-ignore: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Assemble signed github release APK
+    # Only in a fork that has the key; never upstream.
+    if: github.repository != 'andreknieriem/open-headunit'
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Check the signing secrets
+        env:
+          KEYSTORE_BASE64: ${{ secrets.HEADUNIT_KEYSTORE_BASE64 }}
+          KEYSTORE_PASSWORD: ${{ secrets.HEADUNIT_KEYSTORE_PASSWORD }}
+        run: |
+          if [ -z "$KEYSTORE_BASE64" ] || [ -z "$KEYSTORE_PASSWORD" ]; then
+            echo "::error::Add the HEADUNIT_KEYSTORE_BASE64 and HEADUNIT_KEYSTORE_PASSWORD repository secrets (see SIGNING.md)."
+            exit 1
+          fi
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+          cache: gradle
+
+      - name: Set up Android SDK
+        uses: android-actions/setup-android@v4
+        with:
+          packages: ''
+
+      - name: Install required SDK packages
+        run: sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.0.0"
+
+      - name: Restore the signing key
+        env:
+          KEYSTORE_BASE64: ${{ secrets.HEADUNIT_KEYSTORE_BASE64 }}
+        # app/build.gradle.kts reads headunit-release-key.jks from the repository root (git-ignored).
+        run: echo "$KEYSTORE_BASE64" | base64 --decode > headunit-release-key.jks
+
+      - name: Build signed release APK
+        env:
+          HEADUNIT_KEYSTORE_PASSWORD: ${{ secrets.HEADUNIT_KEYSTORE_PASSWORD }}
+          HEADUNIT_KEY_PASSWORD: ${{ secrets.HEADUNIT_KEYSTORE_PASSWORD }}
+        run: |
+          chmod +x ./gradlew
+          ./gradlew :app:assembleGithubRelease --no-daemon --stacktrace
+
+      - name: Remove the signing key
+        if: always()
+        run: rm -f headunit-release-key.jks
+
+      - name: Check the APK is signed with the personal key
+        run: |
+          APK=$(ls app/build/outputs/apk/github/release/*.apk | head -1)
+          "$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --print-certs "$APK" | tee signer.txt
+          grep -q "CN=Open Headunit personal build" signer.txt || { echo "::error::The APK is not signed with the personal key"; exit 1; }
+
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: open-headunit-personal-signed
+          path: app/build/outputs/apk/github/release/*.apk
+          if-no-files-found: error
+
+      - name: Publish as a pre-release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          APK=$(ls app/build/outputs/apk/github/release/*.apk | head -1)
+          TAG="personal-${{ github.run_number }}"
+          cp "$APK" "open-headunit-${TAG}.apk"
+          gh release create "$TAG" "open-headunit-${TAG}.apk" \
+            --target "${{ github.sha }}" --prerelease \
+            --title "Personal build ${{ github.run_number }} (${GITHUB_REF_NAME})" \
+            --notes "Signed with the personal key. Commit ${{ github.sha }}."
