+        override fun draw(
+            canvas: Canvas, text: CharSequence?, start: Int, end: Int,
+            x: Float, top: Int, y: Int, bottom: Int, paint: Paint
+        ) {
+            val fm = paint.fontMetricsInt
+            val centerY = y + (fm.ascent + fm.descent) / 2f
+            canvas.save()
