     <string name="volume_keys_to_phone">वॉल्यूम बटन फ़ोन को भेजें</string>
     <string name="volume_keys_to_phone_summary">वॉल्यूम बटन इस यूनिट के बजाय फ़ोन का वॉल्यूम बदलते हैं।</string>
