+    <string name="aa_key_group_back">Voltar</string>
+    <string name="aa_key_group_phone">Ligar e desligar chamada</string>
+    <string name="aa_key_group_assistant">Assistente de voz</string>
+    <string name="aa_key_group_other">Teclado e outras teclas</string>
     <string name="volume_keys_to_phone">Enviar botões de volume ao celular</string>
