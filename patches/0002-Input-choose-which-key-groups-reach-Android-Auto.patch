+    /** "All", "None", or the groups held back, in the dialog's order. */
+    private fun aaKeyGroupsSummary(heldBack: Set<AaKeyGroupPolicy.Group>): String = when {
+        heldBack.isEmpty() -> getString(R.string.aa_key_groups_all)
