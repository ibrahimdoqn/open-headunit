     <string name="server_mode_help">Auto searches the network for the head unit server on the phone and connects by itself. Manual does not search. You connect from the network list, or with the phone\'s address.</string>
+    <string name="headunit_server_network_label">Connection Method</string>
+    <string name="headunit_server_network_phone">Phone hotspot</string>
