+    <string name="headunit_server_network_shared">Shared WiFi</string>
+    <string name="headunit_server_network_help">Which WiFi the phone and this unit share. Phone hotspot: this unit joins the phone’s hotspot. Until it has, the search for the phone waits, and Connect over WiFi scans for the hotspot first. Unit hotspot: the phone joins this unit’s access point. Shared WiFi: both are on the same router, and nothing changes.</string>
+    <string name="headunit_server_auto_wifi_scan">Scan for the Hotspot Automatically</string>
